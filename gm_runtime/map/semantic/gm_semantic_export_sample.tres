[sub_resource type="Resource" id="Camera"]
script = ExtResource("7")
camera_id = &"gm.camera.export_room"
bounds = Rect2(0, 0, 192, 128)
target_role_id = &"player"

[resource]
script = ExtResource("1")
map_id = &"gm.map_anchor.semantic_export"
terrain_map = SubResource("Terrain")
regions = Array[ExtResource("3")]([SubResource("Region")])
routes = Array[ExtResource("4")]([SubResource("Route")])
anchors = Array[ExtResource("5")]([SubResource("Spawn"),SubResource("Door")])
